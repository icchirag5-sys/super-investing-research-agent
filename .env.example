# Copy this file to .env and fill in your key. NEVER commit .env (it is in .gitignore).

# Which provider to use: gemini (free tier available) or anthropic (paid)
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change over time. If you get "model not found" or a quota error, pick a model that your
# AI Studio account lists as available on the free tier and put its name here.
GEMINI_MODEL=gemini-2.5-flash

# Only if you use --provider anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
